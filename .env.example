# Sao chép file này thành .env rồi thay các giá trị bên dưới.
#   cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore).

# ----- Database PostgreSQL (dịch vụ db) -----
POSTGRES_USER=dapchim
POSTGRES_PASSWORD=doi-mat-khau-db-nay
POSTGRES_DB=dapchim

# ----- Tài khoản trang quản trị /admin -----
# Mật khẩu tối thiểu 12 ký tự, nếu không server sẽ không khởi động.
ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-admin-nay

# 1 = cookie đăng nhập chỉ gửi qua HTTPS (bật khi chạy sau HTTPS, ví dụ máy chủ thật)
COOKIE_SECURE=0
